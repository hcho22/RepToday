<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Waitlist's daily job (US-WL07 and US-WL10, OQ4 option ii): both removal sweeps live, then the anonymous
  view, then the check of the erased sign-ups the founder still has to delete in Kit's web app. This file is a template and is NOT installed by the repository: tools/waitlist/README.md ("Install the
  daily job") says how the founder installs it. Replace __REPO_ROOT__ with the path of the RepToday checkout and
  __HOME__ with the home directory (launchd does not expand "~").

  It holds no credential: the Kit API key is read from the Keychain when the job runs.
  A calendar job that the Mac slept through is started when the Mac next wakes (launchd's documented behavior;
  the go-live rehearsal, US-WL12, records it on the installed job).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.reptoday.waitlist-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO_ROOT__/tools/waitlist/waitlist.py</string>
    <string>daily</string>
    <string>--live</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/RepToday/waitlist-daily.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/RepToday/waitlist-daily.log</string>
</dict>
</plist>
