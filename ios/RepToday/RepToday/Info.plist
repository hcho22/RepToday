<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- The anonymous-telemetry sink's deployment origin (US-T04): the Convex deployment's `.site`
	     host, with the `/logEvent` route appended by `LiveAnalyticsService`. It is configuration
	     rather than a Swift literal so the deployment can move without a code change, and it is
	     expanded from the per-configuration `REPTODAY_ANALYTICS_ENDPOINT` build setting in
	     `ios/RepToday/project.yml` rather than written here, so the destination is a build choice
	     rather than a source edit. Debug carries the *development* deployment
	     `courteous-dogfish-560`; Release carries production deployment `sensible-spider-810`. An
	     empty, missing, or mistyped
	     value makes the build simply inert: `LiveAnalyticsService.configured(...)` returns nil and
	     the container falls back to `NoOpAnalyticsService`, emitting nothing and failing nothing. -->
	<key>RepTodayAnalyticsEndpoint</key>
	<string>$(REPTODAY_ANALYTICS_ENDPOINT)</string>
	<!-- The anonymous-telemetry shared secret (US-T14), sent on every `POST /logEvent` so a stranger
	     who finds the endpoint URL cannot flood the `events` table. Like the endpoint above, it is
	     expanded from the per-configuration `REPTODAY_ANALYTICS_SECRET` build setting rather than
	     written here: Debug carries the *development* deployment's secret; Release receives its
	     production-only value from the captain-owned macOS Keychain via `tools/archive-release.sh`.
	     The source default remains empty, and an empty or missing value is the same inert
	     state as a missing endpoint - `LiveAnalyticsService.configured(...)` returns nil and the
	     container falls back to `NoOpAnalyticsService` - so an unconfigured build sends nothing rather
	     than a stream of rejected requests. This secret is a *cost-raiser*, not a guarantee: it ships
	     inside the binary and is extractable by anyone who unpacks the app. See `convex/README.md`. -->
	<key>RepTodayAnalyticsSecret</key>
	<string>$(REPTODAY_ANALYTICS_SECRET)</string>
	<!-- The premium coach proxy's `POST /coach` origin (US-AC02), expanded from the per-configuration
	     `REPTODAY_COACH_ENDPOINT` build setting exactly like the analytics endpoint above. See
	     `docs/coach-runtime-authentication.md` for configuration and deployment status. An
	     empty/missing/mistyped value makes `CoachProxyClient.configured(...)` return nil, leaving the
	     coach inert (the chat surface shows a clear "coach unavailable" state) rather than pointing at a
	     wrong destination. Production app configuration requires `app-attest-storekit-v1` and no shared
	     secret; the operator bearer remains confined to separate native QA. -->
	<key>RepTodayCoachEndpoint</key>
	<string>$(REPTODAY_COACH_ENDPOINT)</string>
	<!-- The coach client shared secret (US-AC02), expanded from `REPTODAY_COACH_SECRET`, is available
	     only to explicit DEBUG non-production configuration. Ordinary Debug and Release values stay
	     empty. The approved production origin rejects a nonempty value because shipped authentication
	     uses App Attest/StoreKit; the operator bearer must never be distributed in an app binary. -->
	<key>RepTodayCoachSecret</key>
	<string>$(REPTODAY_COACH_SECRET)</string>
	<key>RepTodayBuildConfiguration</key>
	<string>$(CONFIGURATION)</string>
	<key>RepTodayCoachSyntheticQA</key>
	<string>$(REPTODAY_COACH_SYNTHETIC_QA)</string>
	<key>RepTodayCoachAuthMode</key>
	<string>$(REPTODAY_COACH_AUTH_MODE)</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Rep Today saves your completed sessions as workouts in Health so your movement counts where you already track it.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Rep Today checks Health for workouts it previously saved so it can avoid adding duplicate completed sessions. It does not read your other Health data.</string>
</dict>
</plist>
