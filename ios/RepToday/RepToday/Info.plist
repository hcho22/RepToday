<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- The anonymous-telemetry sink's deployment origin (US-T04): the Convex deployment's `.site`
	     host, with the `/logEvent` route appended by `LiveAnalyticsService`. It is configuration
	     rather than a Swift literal so the deployment can move without a code change. This points
	     at the *development* deployment `courteous-dogfish-560`; no production deployment has been
	     chosen yet - which account and plan host the production sink is an open question in
	     `.claude/agent/tasks/prd-funnel-instrumentation_260803.md`. Remove or mistype the value and
	     the build is simply inert: `LiveAnalyticsService.configured(...)` returns nil and the
	     container falls back to `NoOpAnalyticsService`, emitting nothing and failing nothing. -->
	<key>RepTodayAnalyticsEndpoint</key>
	<string>https://courteous-dogfish-560.convex.site</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Rep Today writes your completed sessions to Health so your movement counts where you already track it. It only ever adds workouts and never reads your Health data.</string>
</dict>
</plist>
